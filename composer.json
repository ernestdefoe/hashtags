{
    "name": "ernestdefoe/hashtags",
    "description": "Freeform hashtags for Flarum 2. Write #anything in a post and it becomes a link to a feed of every discussion using it — no admin setup, no pre-created tags. Coexists with flarum/tags: a # that matches a real tag slug stays a tag mention.",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "hashtags",
        "tags",
        "discovery",
        "mentions"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Hashtags\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Hashtags",
            "category": "feature",
            "icon": {
                "name": "fas fa-hashtag",
                "backgroundColor": "#3b6cb5",
                "color": "#ffffff"
            },
            "optional-dependencies": [
                "flarum/mentions",
                "flarum/tags"
            ]
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": false,
                "prettier": false,
                "typescript": false,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": false,
                "styleci": false
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Hashtags\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
