<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit tests only: no database, no booted Flarum (`composer test:unit`).

  Everything here is either pure logic or SQL/parser output inspected without
  being executed, so `composer install` is the whole setup. What needs a real
  install (the API, the post-save sync, the feed filter) is covered by
  phpunit.integration.xml instead.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">./unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">../src/</directory>
        </include>
    </source>
</phpunit>
