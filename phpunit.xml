<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unit tests only: no database, no booted Flarum.

  Everything here is either pure logic or SQL/parser output inspected without
  being executed, so `composer install && vendor/bin/phpunit` is the whole
  setup. That is deliberate — a suite that needs a MySQL service is a suite
  that stops being run.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
